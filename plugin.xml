<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.zhanglinwei.zTools</id>
    <version>1.4.7</version>


    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>zTools</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="3498729975@qq.com" url="https://www.codefy.cn/">Zhang Linwei</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>
        <![CDATA[
            <p>A Java / Spring toolbox: API docs, JSON / cURL from source, Restful navigation, YApi upload, Jasypt encrypt/decrypt, database docs, and inner Builder generation.</p>
            <p>面向 Java / Spring 的开发工具：生成接口文档、类转 JSON、Restful 跳转、复制 cURL、上传 YApi、Jasypt 加解密、库表文档、内部 Builder。</p>
            <p><b>Minimum supported IDEA version: 2022.1.1</b> (Java plugin required)</p>
            <p>Documentation:</p>
            <ul>
                <li><a href="https://github.com/zhanglinweigithub/zTools/blob/main/README.md">GitHub README</a></li>
                <li><a href="https://gitee.com/linwei-zhang/z-tools/blob/master/README.md">Gitee README</a></li>
            </ul>
            <p>Features:</p>
            <ul>
                <li><b>API documentation</b> — Generate Html / MarkDown / Word from Spring Controllers (OpenAPI / Swagger / validation / JavaDoc). 从 Controller 生成 Html、MarkDown、Word 接口文档。</li>
                <li><b>Copy JSON</b> — Class to commented example JSON (nesting, generics, inheritance, enums). 类转带注释的示例 JSON。</li>
                <li><b>Copy cURL</b> — Mapping method to a runnable curl (port and context-path from application.*). Mapping 方法复制为可执行 curl。</li>
                <li><b>Go to Restful</b> — Search Spring MVC / Feign APIs by path, shortcut Ctrl+\. 按路径搜索并跳转接口。</li>
                <li><b>Upload YApi</b> — Push one method or a whole Controller / Feign type to YApi. 上传接口到 YApi。</li>
                <li><b>Jasypt Crypto</b> — Encrypt / decrypt ENC(...) in the editor; decrypt a whole file. 编辑器内 Jasypt 加解密，支持整文件解密。</li>
                <li><b>Database documentation</b> — MySQL table docs (Html / MarkDown / Word) from zTools.yaml. 从 zTools.yaml 读数据源生成库表文档。</li>
                <li><b>Inner Builder</b> — Generate Builder (lite or generic, record, inheritance). 生成内部 Builder 类。</li>
            </ul>
            <p>Configure under <b>Settings → z-tools</b> (project-level, stored in .idea/zTools.xml).</p>
        ]]>
    </description>

