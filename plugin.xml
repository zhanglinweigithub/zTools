    <idea-version since-build="221.0"/>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <!--    <depends>com.intellij.database</depends>-->

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="com.zhanglinwei.zTools.NotificationGroup"
                           displayType="BALLOON"
                           key="com.zhanglinwei.zTools.util.NotificationGroup"/>
        <projectConfigurable id="zTools"
                             instance="com.zhanglinwei.zTools.configure.settings.ZToolsConfigSettings"
                             displayName="z-tools"/>
        <projectService serviceImplementation="com.zhanglinwei.zTools.configure.config.DocumentConfig"/>
        <projectService serviceImplementation="com.zhanglinwei.zTools.configure.config.JasyptCryptoConfig"/>
        <projectService serviceImplementation="com.zhanglinwei.zTools.configure.config.YApiConfig"/>
        <projectService serviceImplementation="com.zhanglinwei.zTools.configure.config.RestfulConfig"/>

        <!--
            secondary 是否次要窗口: 次要窗口不会在 IDE 启动时自动显示，需用户手动打开
            canCloseContents 内容关闭控制: 禁止用户关闭工具窗口的内容区域（但窗口本身仍可通过 IDE 操作隐藏），常用于核心功能窗口以避免误操作
            doNotActivateOnStart 启动激活: IDE 启动时自动激活该工具窗口
        -->
<!--        <toolWindow id="zTools"-->
<!--                    factoryClass="com.zhanglinwei.zTools.tools.ZToolsToolWindowFactory"-->
<!--                    anchor="right" secondary="false" canCloseContents="false" doNotActivateOnStart="false"-->
<!--                    icon="/icons/pluginIcon.svg"/>-->
    </extensions>

    <!-- icon (only supports AllIcons.*): https://intellij-icons.jetbrains.design/ -->
    <actions>
        <!-- 生成数据库文档 -->
        <action id="generate-db-doc.ID" class="com.zhanglinwei.zTools.dbdoc.GenerateDatabaseDocumentAction" text="Generate DB Doc">
            <add-to-group group-id="ToolsBasicGroup" anchor="first"/>
        </action>

        <!-- 搜索 Restful 接口 -->
        <action id="go-to-restful.ID" class="com.zhanglinwei.zTools.restful.GoToRestfulAction" >
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl BACK_SLASH"/>
        </action>

        <!-- 生成 Builder -->
        <action id="generate-builder.ID" class="com.zhanglinwei.zTools.generatebuilder.GenerateBuilderAction" text="Builder">
            <add-to-group group-id="JavaGenerateGroup1" anchor="after" relative-to-action="GenerateGetterAndSetter"/>
        </action>



        <!-- 拷贝JSON -->
        <action id="copy-json.ID" class="com.zhanglinwei.zTools.copyjson.CopyJsonAction"
                text="Copy Json">
            <add-to-group group-id="EditorLangPopupMenu" anchor="first"/>
        </action>

        <!-- 拷贝CURL -->
        <action id="copy-curl.ID" class="com.zhanglinwei.zTools.copycurl.CopyCurlAction" text="Copy CURL">
            <add-to-group group-id="EditorLangPopupMenu" anchor="after" relative-to-action="copy-json.ID"/>
        </action>

        <!-- 生成API文档 -->
        <action id="generate-api-doc.ID" class="com.zhanglinwei.zTools.apidoc.GenerateApiDocAction"
                text="Generate Api Doc">
            <add-to-group group-id="EditorLangPopupMenu" anchor="after" relative-to-action="copy-curl.ID"/>
        </action>

        <!-- 上传至 YApi -->
        <action id="upload-to-yapi.ID" class="com.zhanglinwei.zTools.yapi.UploadToYApiAction" text="Upload YApi">
            <add-to-group group-id="EditorLangPopupMenu" anchor="after" relative-to-action="generate-api-doc.ID"/>
        </action>

        <!-- 数据加解密操作组 -->
        <group id="JasyptCryptoGroup.ID" text="Jasypt Crypto" popup="true">
            <add-to-group group-id="EditorLangPopupMenu" anchor="after" relative-to-action="upload-to-yapi.ID" />
            <!-- 加密数据 -->
            <action id="encrypt.ID" class="com.zhanglinwei.zTools.jasyptcrypto.EncryptAction"
                    text="Encrypt"/>
            <!-- 解密数据 -->
            <action id="decrypt.ID" class="com.zhanglinwei.zTools.jasyptcrypto.DecryptAction"
                    text="Decrypt"/>
            <!-- 解密数据至剪贴板 -->
            <action id="decrypt-to-clipboard.ID" class="com.zhanglinwei.zTools.jasyptcrypto.Decrypt2ClipboardAction"
                    text="Decrypt To Clipboard" />
            <!-- 解密文件内所有加密数据 -->
            <action id="decrypt-file.ID" class="com.zhanglinwei.zTools.jasyptcrypto.DecryptFileAction"
                    text="Decrypt File" />
        </group>

        <!-- 测试：拷贝注解模块解析出的类 / 方法定义 JSON -->
